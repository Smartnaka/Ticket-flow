# ==============================================================================
# TicketWave Environment Variables
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Security & Authentication
# ------------------------------------------------------------------------------
# Secret key used for signing JWT authentication tokens (min 32 characters recommended)
JWT_SECRET="ticketwave_super_secret_jwt_key_32_bytes_min!"

# ------------------------------------------------------------------------------
# 2. Payment Gateway Configuration (Bachs.io / Paystack / Flutterwave)
# ------------------------------------------------------------------------------
# Active payment provider: 'bachs' | 'paystack' | 'flutterwave'
PAYMENT_PROVIDER="bachs"

# Secret API Key provided by your payment gateway (e.g. Bachs, Paystack, Flutterwave)
PAYMENT_SECRET_KEY="bachs_sk_test_ticketwave_sandbox_secret"

# Public API Key / Client Key provided by your payment gateway
PAYMENT_PUBLIC_KEY="bachs_pk_test_ticketwave_sandbox_public"

# Webhook Signing Secret used to verify incoming webhook signatures (x-bachs-signature / x-paystack-signature)
PAYMENT_WEBHOOK_SECRET="bachs_whsec_ticketwave_sandbox_webhook_secret_key"

# ------------------------------------------------------------------------------
# 3. Application & Server Settings
# ------------------------------------------------------------------------------
# Base URL of the application (used for checkout redirects & webhook callback generation)
APP_URL="http://localhost:3000"

# Application runtime environment: 'development' | 'production'
NODE_ENV="development"

# Relational Database Connection Path (SQLite / Drizzle storage)
DATABASE_URL="file:./data/ticketwave.db"

# Platform Service Fee charged on paid tickets (e.g., 5 = 5%)
PLATFORM_FEE_PERCENTAGE="5"

# ------------------------------------------------------------------------------
# 4. Email & Notification Services
# ------------------------------------------------------------------------------
# API Key for transactional email provider (SendGrid / Mailgun / Resend)
EMAIL_PROVIDER_KEY="mock_sendgrid_key_for_sandbox"

# Sender Email Address displayed on automated ticket receipts
FROM_EMAIL="tickets@ticketwave.app"

